<div class="min-h-screen bg-gray-100">

    <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <!-- Welcome Section -->
        <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
            <h1 class="text-3xl font-bold text-gray-900">Welcome,<%= user.username %> 👋</h1>
            <p class="mt-2 text-gray-600">Ready to test your JavaScript knowledge?</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Themes and Scores Section -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-lg shadow-sm p-6">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-semibold text-gray-900">Your Progress</h2>
                        <a href="/themes" 
                           class="bg-yellow-500 text-white px-6 py-2 rounded-md hover:bg-yellow-600 transition flex items-center">
                            <span>Start New Quiz</span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    </div>
                    
                    <div class="space-y-4">
                       
                            <div class="border rounded-lg p-4">
                                <div class="flex justify-between items-center">
                                    <h3 class="text-lg font-medium text-gray-900">JavaScript</h3>
                                    <span class="text-2xl font-bold text-yellow-500">
                                        0
                                    </span>
                                </div>
                                <div class="mt-2 w-full bg-gray-200 rounded-full h-2.5">
                                    <div class="bg-yellow-500 h-2.5 rounded-full"></div>
                                </div>
                            </div>
                       
                    </div>
                </div>
            </div>

            <!-- Leaderboard Section -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-lg shadow-sm p-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-6">Top 5 Players 🏆</h2>
                    <div class="space-y-4">
                       
                            <div class="flex items-center justify-between p-3  'bg-yellow-50' : 'bg-gray-50' %> rounded-lg">
                                <div class="flex items-center space-x-3">
                                    <span class=" 'text-yellow-500' : 'text-gray-500' %> font-bold">
                                      
                                    </span>
                                    <span class="font-medium text-gray-900"><%= user.username %></span>
                                </div>
                                <span class="font-bold text-gray-900">0 pts</span>
                            </div>
                        
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="mt-6">
            <div class="bg-white rounded-lg shadow-sm p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-6">Recent Activity</h2>
                <div class="space-y-4">
                    
                        <div class="flex items-center justify-between border-b pb-4">
                            <div>
                                <h3 class="font-medium text-gray-900"> JavaScript </h3>
                                <p class="text-sm text-gray-500">Completed  quiz.date </p>
                            </div>
                            <div class="text-right">
                                <span class="text-lg font-bold text-yellow-500"> 0 %</span>
                                <p class="text-sm text-gray-500"> quiz0 / 12  correct</p>
                            </div>
                        </div>
            
                </div>
            </div>
        </div>
    </div>
</div>