<header class="flex items-center justify-between bg-white shadow px-6 py-4">
  <!-- Left: user info -->
  <div class="flex items-center gap-3">
    <span class="text-yellow-500 text-2xl"><i data-lucide="user"></i></span>

    <h1 class="font-medium text-lg">
      <%= user ? user.username : "Guest" %>
    </h1>

    <% if (user) { 
      const badgeColors = {
        Beginner: 'bg-yellow-100 text-yellow-800',
        Intermediate: 'bg-blue-100 text-blue-800',
        Expert: 'bg-green-100 text-green-800'
      };
      const badgeClass = badgeColors[user.badge] || 'bg-gray-100 text-gray-800';
    %>
      <span class="px-2 py-1 text-sm rounded-full <%= badgeClass %>">
        <%= user.badge %>
      </span>
    <% } %>
  </div>

  <!-- Center: app name -->
  <h2 class="text-xl font-semibold text-center flex-1">
    JSQuiz <span class="text-yellow-500">Pro</span>
  </h2>

  <!-- Right: logout button -->
  <% if (user) { %>
    <div class="flex items-center">
      <form action="/auth/logout" method="POST">
        <button 
          type="submit" 
          class="bg-red-500 text-white px-4 py-2 rounded-md hover:bg-red-600 transition">
          Logout
        </button>
      </form>
    </div>
  <% } else { %>
    <div></div> <!-- empty placeholder to keep layout aligned -->
  <% } %>
</header>
